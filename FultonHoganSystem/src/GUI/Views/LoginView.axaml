<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GUI.Views.LoginView">
    
    <Border Background="#2c3e50" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Spacing="15">
            
            <TextBlock Text="FULTON HOGAN" FontSize="28" Foreground="White" 
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <Border Background="White" Padding="20" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Email Address" Foreground="#7f8c8d" FontSize="12"/>
                    <TextBox x:Name="EmailBox" Watermark="e.g. bob@fh.com"/>
                    
                    <TextBlock Text="Password" Foreground="#7f8c8d" FontSize="12" Margin="0,10,0,0"/>
                    <TextBox x:Name="PasswordBox" PasswordChar="*" Watermark="••••••••"/>
                    
                    <Button Content="LOGIN" Click="OnLoginClick" 
                            Background="#2980b9" Foreground="White"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="40" Margin="0,20,0,0"/>
                    
                    <TextBlock x:Name="ErrorLabel" Foreground="Red" FontSize="12" 
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </Border>
</UserControl>