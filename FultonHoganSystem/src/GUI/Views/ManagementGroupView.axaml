<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GUI.Views.RoleViews.ManagementGroupView">
    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="220" Background="#2c3e50" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="MANAGEMENT" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <ListBox x:Name="ProjectListBox" Height="250" Background="#34495e" SelectionChanged="OnProjectSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Foreground="White"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+ New Project" Click="OnAddProjectClick" 
                        Background="#27ae60" Foreground="White" 
                        HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                <Button Content="Mark Selected Modified" Click="OnModifyClick"
                        Background="#2980b9" Foreground="White"
                        HorizontalAlignment="Stretch"/>

                <Separator Background="#34495e" Margin="0,10"/>
                <Button Content="Logout" Click="OnLogoutClick" Background="#c0392b" Foreground="White" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer>
            <StackPanel Margin="20" Spacing="20">
                <TextBlock x:Name="SelectedProjectTitle" Text="Project Overview" FontSize="24" FontWeight="Bold"/>

                <!-- Project Specifications -->
                <Border x:Name="ProjectDetailsPanel" IsVisible="False" Background="White" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Full Specifications" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <DockPanel><TextBlock Text="Status: "/><TextBlock x:Name="SelectedProjectStatus" FontWeight="Bold"/></DockPanel>
                        <DockPanel><TextBlock Text="Deadline: "/><TextBlock x:Name="TxtDeadline"/></DockPanel>
                        <DockPanel><TextBlock Text="Budget: "/><TextBlock x:Name="TxtBudget" Foreground="#27ae60"/></DockPanel>
                        <DockPanel><TextBlock Text="Spendings: "/><TextBlock x:Name="TxtSpend" Foreground="#c0392b"/></DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Tasks" FontWeight="Bold" FontSize="18"/>
                <ListBox x:Name="TaskDetailsList" Height="150" Background="Transparent"/>

                <!-- THE MISSING ELEMENT: ActionLog -->
                <Border Background="#fdfdfd" BorderBrush="#eee" BorderThickness="1" Padding="10">
                    <TextBlock x:Name="ActionLog" Text="System ready." Foreground="#2980b9" FontStyle="Italic"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
